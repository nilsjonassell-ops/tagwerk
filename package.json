{
  "name": "tagwerk",
  "productName": "Tagwerk",
  "version": "1.4.0",
  "description": "Persönliches Produktivitäts-Dashboard: Kalender, E-Mail, Aufgaben, Notizen und Fokus",
  "main": "./out/main/index.js",
  "author": "Nils Sell",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "date-fns": "^4.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "de.nilssell.tagwerk",
    "productName": "Tagwerk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Tagwerk-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tagwerk",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nilsjonassell-ops",
        "repo": "tagwerk",
        "releaseType": "release"
      }
    ]
  }
}
